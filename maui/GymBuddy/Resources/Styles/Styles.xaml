<?xml version="1.0" encoding="UTF-8" ?>
<!-- Spacing 4/8/12/16/24, radii 6/10/14 and type scale from src/theme.ts. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <Thickness x:Key="PagePadding">16,16,16,48</Thickness>

    <!-- Pages -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Text}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Text}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Border}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Muted}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Muted}" />
    </Style>

    <!-- Text -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Small" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Strong" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <!-- Bordered text box: a Border with this style wrapping a borderless Entry. -->
    <Style x:Key="InputBox" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- Buttons (src/components/Button.tsx) -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="TextTransform" Value="None" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="Background" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Background" Value="{StaticResource CardColor}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}" />
        <Setter Property="Background" Value="{StaticResource DangerSoft}" />
        <Setter Property="BorderColor" Value="{StaticResource DangerSoft}" />
        <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
    </Style>
    <Style x:Key="PrimarySmall" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
    <Style x:Key="SecondarySmall" TargetType="Button" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
    <Style x:Key="DangerSmall" TargetType="Button" BasedOn="{StaticResource Danger}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>
    <Style x:Key="GhostSmall" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <!-- Icon-only button (Ionicons glyph as text). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Ionicons" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="40" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.35" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.35" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
</ResourceDictionary>
