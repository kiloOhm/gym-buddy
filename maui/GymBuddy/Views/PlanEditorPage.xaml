<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase
    x:Class="GymBuddy.Views.PlanEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBuddy.Views"
    xmlns:vm="clr-namespace:GymBuddy.ViewModels"
    xmlns:c="clr-namespace:GymBuddy.Controls"
    x:DataType="vm:PlanEditorViewModel"
    Shell.TabBarIsVisible="False"
    Title="{Binding Title}">
    <Grid>
        <VerticalStackLayout IsVisible="{Binding Found, Converter={StaticResource Not}}" VerticalOptions="Center" Padding="24" Spacing="12">
            <Label Text="Plan not found" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label Text="It may have been deleted." FontSize="14" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            <Button Style="{StaticResource Secondary}" Text="Go back" Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>

        <ScrollView IsVisible="{Binding Found}">
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource Small}" Text="Plan name" />
                        <VerticalStackLayout Spacing="0">
                            <Entry x:Name="NameEntry" Text="{Binding NameText}" FontSize="20" FontAttributes="Bold" Placeholder="Plan name"
                                   ReturnType="Done" ReturnCommand="{Binding SaveNameCommand}" />
                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                        </VerticalStackLayout>
                        <Button Style="{StaticResource SecondarySmall}" Text="Export" HorizontalOptions="Start" Command="{Binding ExportCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoExercises}">
                    <Label Style="{StaticResource Small}" Text="No exercises yet. Add some to build your plan." />
                </Border>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Rows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlannedRowViewModel">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,40,40,40" ColumnSpacing="4">
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <Label Text="{Binding Title}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Style="{StaticResource Small}" Text="{Binding EquipmentText}" IsVisible="{Binding HasEquipment}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Text="&#xf241;" SemanticProperties.Description="Move up"
                                                IsEnabled="{Binding CanMoveUp}" Command="{Binding MoveUpCommand}" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Text="&#xf232;" SemanticProperties.Description="Move down"
                                                IsEnabled="{Binding CanMoveDown}" Command="{Binding MoveDownCommand}" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Text="&#xf5f6;" SemanticProperties.Description="Remove"
                                                Command="{Binding RemoveCommand}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <c:ValueStepper Label="Sets" Min="1" Max="10" Value="{Binding Sets}" Command="{Binding ChangeSetsCommand}" />
                                        <c:ValueStepper Grid.Column="1" Label="Reps" Min="1" Max="30" Value="{Binding Reps}" Command="{Binding ChangeRepsCommand}" />
                                        <c:ValueStepper Grid.Column="2" Label="Rest" Min="0" Max="600" Step="15" Suffix="s" Value="{Binding RestSec}" Command="{Binding ChangeRestCommand}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Style="{StaticResource Secondary}" Text="Add exercise" Command="{Binding AddExerciseCommand}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource Heading}" Text="Muscle coverage" />
                        <Label Style="{StaticResource Small}" Text="{Binding SummaryLine}" />
                        <c:BodyMapView x:Name="BodyMap" Values="{Binding CoverageValues}" Selected="{Binding Tapped}" Tappable="True" />
                        <Label Style="{StaticResource Small}" Text="{Binding TappedText}" IsVisible="{Binding TappedText, Converter={StaticResource NotNull}}" />
                        <c:MuscleCoverageBarsView Values="{Binding CoverageValues}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasActive}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource Small}" Text="{Binding ActiveText}" />
                        <Button Text="Go to workout" Command="{Binding GoToWorkoutCommand}" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Start workout" Command="{Binding StartCommand}" IsVisible="{Binding HasActive, Converter={StaticResource Not}}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</views:PageBase>
