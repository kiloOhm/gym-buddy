<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase
    x:Class="GymBuddy.Views.WorkoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBuddy.Views"
    xmlns:vm="clr-namespace:GymBuddy.ViewModels"
    xmlns:c="clr-namespace:GymBuddy.Controls"
    x:DataType="vm:WorkoutViewModel"
    Title="Workout">

    <Grid>
        <!-- No active session: pick a plan -->
        <ScrollView IsVisible="{Binding HasSession, Converter={StaticResource Not}}">
            <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">
                <Label Style="{StaticResource Title}" Text="Start a workout" />
                <VerticalStackLayout IsVisible="{Binding HasNoPlans}" Padding="24" Spacing="12">
                    <Label Text="No plans yet" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="Create a plan in the Plans tab, or start an empty workout and add exercises as you go."
                           FontSize="14" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding StartPlans}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartPlanRow">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Style="{StaticResource Heading}" Text="{Binding Name}" />
                                        <Label Style="{StaticResource Small}" Text="{Binding Meta}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Start" Command="{Binding StartCommand}" CommandParameter="{Binding Id}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Style="{StaticResource Secondary}" Text="Start empty workout" Command="{Binding StartCommand}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Active session -->
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasSession}">
            <VerticalStackLayout Padding="16,16,16,0" Spacing="12" ZIndex="1" BackgroundColor="{StaticResource Background}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Style="{StaticResource Title}" Text="{Binding PlanName}" MaxLines="2" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Elapsed}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                </Grid>
                <c:RestTimerBar />
            </VerticalStackLayout>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoExercises}">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="No exercises yet." HorizontalTextAlignment="Center" />
                            <Label Style="{StaticResource Small}" Text="Add one below to start logging sets." HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Cards}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionCardViewModel">
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*,44" ColumnSpacing="8">
                                            <c:ExerciseFigureView Exercise="{Binding Exercise}" Variant="Thumb" Size="44" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Text="&#xf399;" FontSize="24"
                                                    TextColor="{StaticResource PrimaryColor}" WidthRequest="44"
                                                    SemanticProperties.Description="Exercise details" Command="{Binding InfoCommand}" />
                                        </Grid>
                                        <Label Style="{StaticResource Small}" Text="{Binding Targets}" />
                                        <Label Style="{StaticResource Small}" Text="{Binding SwappedFor}" IsVisible="{Binding HasSwappedFor}" />

                                        <Border IsVisible="{Binding HasStats}" BackgroundColor="{StaticResource Background}"
                                                StrokeShape="RoundRectangle 6" Padding="8" Margin="0,4,0,0">
                                            <VerticalStackLayout Spacing="4">
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                    <VerticalStackLayout>
                                                        <Label Style="{StaticResource Caption}" Text="Best" />
                                                        <Label Text="{Binding StatBest}" FontSize="13" FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1">
                                                        <Label Style="{StaticResource Caption}" Text="Last" />
                                                        <Label Text="{Binding StatLast}" FontSize="13" FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2">
                                                        <Label Style="{StaticResource Caption}" Text="30d avg" />
                                                        <Label Text="{Binding StatAvg}" FontSize="13" FontAttributes="Bold" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <Label Style="{StaticResource Caption}" Text="{Binding StatNote}" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Label Text="{Binding LastLine}" IsVisible="{Binding HasLastLine}" FontSize="13" TextColor="{StaticResource PrimaryColor}" Margin="0,4,0,0" />

                                        <Grid ColumnDefinitions="32,*,*,52" ColumnSpacing="8" Margin="0,8,0,0">
                                            <Label Style="{StaticResource Caption}" Text="Set" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding UnitLabel}" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="2" Style="{StaticResource Caption}" Text="Reps" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="3" Style="{StaticResource Caption}" Text="Done" HorizontalTextAlignment="Center" />
                                        </Grid>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SetRowViewModel">
                                                    <Border StrokeShape="RoundRectangle 6" Padding="0,4">
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Completed}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="{StaticResource SuccessSoft}" />
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Grid ColumnDefinitions="32,*,*,52" ColumnSpacing="8">
                                                            <Label Text="{Binding Number}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                            <Border Grid.Column="1" BackgroundColor="{StaticResource CardColor}" Stroke="{StaticResource Border}" StrokeThickness="1"
                                                                    StrokeShape="RoundRectangle 6" HeightRequest="44">
                                                                <Entry Text="{Binding WeightText}" Keyboard="Numeric" Placeholder="0" FontSize="16"
                                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                                       SemanticProperties.Description="{Binding Number, StringFormat='Set {0} weight'}" />
                                                            </Border>
                                                            <Border Grid.Column="2" BackgroundColor="{StaticResource CardColor}" Stroke="{StaticResource Border}" StrokeThickness="1"
                                                                    StrokeShape="RoundRectangle 6" HeightRequest="44">
                                                                <Entry Text="{Binding RepsText}" Keyboard="Numeric" Placeholder="0" FontSize="16"
                                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                                       SemanticProperties.Description="{Binding Number, StringFormat='Set {0} reps'}" />
                                                            </Border>
                                                            <Button Grid.Column="3" Text="✓" FontSize="20" FontAttributes="Bold" WidthRequest="44" HeightRequest="44"
                                                                    MinimumWidthRequest="44" Padding="0" CornerRadius="10" BorderWidth="2" HorizontalOptions="Center"
                                                                    BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource Border}" TextColor="{StaticResource Border}"
                                                                    SemanticProperties.Description="{Binding Number, StringFormat='Set {0} done'}"
                                                                    Command="{Binding ToggleDoneCommand}">
                                                                <Button.Triggers>
                                                                    <DataTrigger TargetType="Button" Binding="{Binding Completed}" Value="True">
                                                                        <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                                                                        <Setter Property="BorderColor" Value="{StaticResource Success}" />
                                                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                                                    </DataTrigger>
                                                                </Button.Triggers>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                                            <Button Style="{StaticResource SecondarySmall}" Text="+ Set" Command="{Binding AddSetCommand}" />
                                            <Button Grid.Column="1" Style="{StaticResource SecondarySmall}" Text="− Set" Command="{Binding RemoveSetCommand}" IsVisible="{Binding CanRemoveSet}" />
                                            <Button Grid.Column="3" Style="{StaticResource GhostSmall}" Text="Swap" Command="{Binding SwapCommand}" />
                                            <Button Grid.Column="4" Style="{StaticResource DangerSmall}" Text="Remove" Command="{Binding RemoveCommand}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Style="{StaticResource Secondary}" Text="Add exercise" Command="{Binding AddExerciseCommand}" />
                    <VerticalStackLayout Spacing="8" Margin="0,12,0,0">
                        <Button Text="Finish workout" Command="{Binding FinishCommand}" />
                        <Button Style="{StaticResource Danger}" Text="Discard" Command="{Binding DiscardCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</views:PageBase>
