<?xml version="1.0" encoding="utf-8" ?>
<views:PageBase
    x:Class="GymBuddy.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GymBuddy.Views"
    xmlns:vm="clr-namespace:GymBuddy.ViewModels"
    xmlns:c="clr-namespace:GymBuddy.Controls"
    x:DataType="vm:HomeViewModel"
    Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="12">

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasActive}"
                    BackgroundColor="{StaticResource PrimarySoft}" Stroke="{StaticResource PrimaryColor}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource Heading}" Text="{Binding ActiveTitle}" />
                    <Button Text="Continue" Command="{Binding ContinueCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource Heading}" Text="Last workout" VerticalOptions="Center" />
                        <Button Grid.Column="1" Style="{StaticResource GhostSmall}" Text="History"
                                IsVisible="{Binding HasLast}" Command="{Binding GoToHistoryCommand}" />
                    </Grid>
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding HasLast, Converter={StaticResource Not}}">
                        <Label Style="{StaticResource Small}" Text="No workouts yet. Start one from a plan." />
                        <Button Style="{StaticResource Secondary}" Text="Go to plans" Command="{Binding GoToPlansCommand}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2" MinimumHeightRequest="44" IsVisible="{Binding HasLast}">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLastCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Style="{StaticResource Small}" Text="{Binding LastDate}" />
                        <Label Text="{Binding LastName}" FontSize="16" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Style="{StaticResource Small}" Text="{Binding LastMeta}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource Heading}" Text="{Binding LoadTitle}" />
                    <c:BodyMapView MapScale="Load" Values="{Binding LoadValues}" />
                    <c:LoadHintsView Hints="{Binding Hints}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding Caption}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:PageBase>
