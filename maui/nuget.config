<?xml version="1.0" encoding="utf-8"?>
<!-- Restore the MAUI port from the NuGet V3 feed regardless of the machine's global NuGet.Config
     (a V2-only config makes workload and package restores slow or fail). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
